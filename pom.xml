<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.robofleet</groupId>
    <artifactId>robofleet-control-plane</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>robofleet-control-plane</name>
    <description>Root selector/aggregator build for RoboFleet modules</description>

    <properties>
        <skipContractTests>false</skipContractTests>
    </properties>

    <modules>
        <module>fleet-state-service</module>
        <module>robot-simulator</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>pact-generate-fleet-state-service</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipContractTests}</skip>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>-f</argument>
                                <argument>${project.basedir}/fleet-state-service/pom.xml</argument>
                                <argument>-Ppact-generate</argument>
                                <argument>-Dpact.rootDir=${project.basedir}/pacts</argument>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>pact-generate-robot-simulator</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipContractTests}</skip>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>-f</argument>
                                <argument>${project.basedir}/robot-simulator/pom.xml</argument>
                                <argument>-Ppact-generate</argument>
                                <argument>-Dpact.rootDir=${project.basedir}/pacts</argument>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>pact-verify-fleet-state-service</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipContractTests}</skip>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>-f</argument>
                                <argument>${project.basedir}/fleet-state-service/pom.xml</argument>
                                <argument>-Ppact-verify</argument>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>pact-verify-robot-simulator</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipContractTests}</skip>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>-f</argument>
                                <argument>${project.basedir}/robot-simulator/pom.xml</argument>
                                <argument>-Ppact-verify</argument>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>